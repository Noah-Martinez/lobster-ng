+validate_https_url() {
+    url=$1
+
+    case "$url" in
+        https://*) ;;
+        *) return 1 ;;
+    esac
+
+    case "$url" in
+        *"$nl"*) return 1 ;;
+    esac
+
+    return 0
+}
+
+validate_https_lines() {
+    while IFS= read -r url; do
+        [ -z "$url" ] && continue
+        if ! validate_https_url "$url"; then
+            return 1
+        fi
+    done
+}
